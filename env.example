# Required — from @BotFather (format: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=
 
# search4faces.com JSON-RPC key — leave empty for mock-only testing
SEARCH4FACES_API_KEY=

# true = force simulated API (ignores key for calls)
MOCK_API=false

# Rows requested per searchFace call (5–30)
API_RESULTS_FETCH=10

# Pause between each source after a search (seconds)
SOURCE_DELAY_SEC=1

# API endpoint override (optional)
# SEARCH4FACES_API_URL=https://search4faces.com/api/json-rpc/v1

# searchFace language for returned fields
SEARCH_LANG=en

# Include hidden profiles in searchFace
INCLUDE_HIDDEN_PROFILES=true

# Skip auto pip install inside tele4faces.py
# TELE4FACES_NO_AUTO_PIP=1
