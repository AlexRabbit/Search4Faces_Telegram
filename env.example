# Copy this file to ".env" in the same folder as tele4faces.py (never commit real secrets).
#   Windows:  copy env.example .env
#   Linux/macOS:  cp env.example .env

# --- Required: Telegram ---
# From @BotFather (looks like 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# --- Search4Faces API ---
# From https://search4faces.com/ — leave empty until you have a key; the bot will run in mock mode.
SEARCH4FACES_API_KEY=

# false = use real API when SEARCH4FACES_API_KEY is set. true = always simulate (ignores key for API calls).
MOCK_API=false

# Max matches per source per search (1–50)
RESULTS_PER_SOURCE=10

# Pause between each source request (seconds); helps respect rate limits
SOURCE_DELAY_SEC=0.69

# --- Optional ---
# SEARCH_SOURCES=vk_wall,vkok_avatar,tt_avatar,ch_avatar,vkokn_avatar,sb_photo
# SEARCH_LANG=en
# INCLUDE_HIDDEN_PROFILES=true
# SEARCH4FACES_API_URL=https://search4faces.com/api/json-rpc/v1
# TELEGRAM_TOKEN=   # alias for TELEGRAM_BOT_TOKEN if you prefer that name

# Skip automatic "pip install -r requirements.txt" inside tele4faces.py (default is to auto-install when needed)
# TELE4FACES_NO_AUTO_PIP=1
